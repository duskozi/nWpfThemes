<!--
  High Contrast Black theme

  Black and white with a yellow accent and strong outlines. A fixed palette; the
  High Contrast theme follows the Windows colours instead.
  Matches the HighContrast skin of nDAWControls.
  Every theme defines the same keys (see ThemeKeys.cs). To make your own theme, copy this
  file into your app, change the values, and apply it with ThemeManager.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Identity -->
    <sys:String x:Key="NwtThemeName">High Contrast Black</sys:String>

    <!-- Typography -->
    <FontFamily x:Key="NwtFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="NwtInputFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="NwtHeaderFontFamily">Segoe UI</FontFamily>
    <FontWeight x:Key="NwtHeaderFontWeight">SemiBold</FontWeight>
    <sys:Double x:Key="NwtFontSize">13</sys:Double>
    <sys:Double x:Key="NwtFontSizeSmall">11.5</sys:Double>
    <sys:Double x:Key="NwtFontSizeLarge">16</sys:Double>

    <!-- Shape and spacing -->
    <CornerRadius x:Key="NwtControlCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="NwtOverlayCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="NwtPanelCornerRadius">2</CornerRadius>
    <Thickness x:Key="NwtControlBorderThickness">1</Thickness>
    <Thickness x:Key="NwtControlPadding">10,4</Thickness>
    <sys:Double x:Key="NwtControlMinHeight">28</sys:Double>
    <sys:Double x:Key="NwtProgressBarThickness">10</sys:Double>
    <sys:Double x:Key="NwtFocusStrokeThickness">2</sys:Double>
    <sys:Double x:Key="NwtFocusCornerRadius">3</sys:Double>

    <!-- Colours -->
    <Color x:Key="NwtBackgroundColor">#FF000000</Color>
    <Color x:Key="NwtSurfaceColor">#FF000000</Color>
    <Color x:Key="NwtForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="NwtAccentColor">#FFFFD400</Color>
    <Color x:Key="NwtBorderColor">#FFFFFFFF</Color>
    <Color x:Key="NwtShadowColor">#99000000</Color>

    <!-- Window and text -->
    <SolidColorBrush x:Key="NwtBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtSurfaceBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtSurfaceAltBrush" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="NwtForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtForegroundSecondaryBrush" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="NwtForegroundDisabledBrush" Color="#FF666666" />
    <SolidColorBrush x:Key="NwtBorderBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtBorderHoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtSeparatorBrush" Color="#FFFFFFFF" />

    <!-- Control faces -->
    <SolidColorBrush x:Key="NwtControlBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtControlHoverBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="NwtControlPressedBrush" Color="#FF404040" />
    <SolidColorBrush x:Key="NwtControlDisabledBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtControlForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtControlHoverForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtControlBorderBrush" Color="#FFFFFFFF" />
    <LinearGradientBrush x:Key="NwtControlBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#24FFFFFF" Offset="0" /><GradientStop Color="#24FFFFFF" Offset="0.5" /><GradientStop Color="#38000000" Offset="0.5" /><GradientStop Color="#38000000" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlPressedBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#24FFFFFF" Offset="0" /><GradientStop Color="#24FFFFFF" Offset="0.5" /><GradientStop Color="#38000000" Offset="0.5" /><GradientStop Color="#38000000" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlCheckedBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#73FFFFFF" Offset="0" /><GradientStop Color="#73FFFFFF" Offset="0.5" /><GradientStop Color="#26000000" Offset="0.5" /><GradientStop Color="#26000000" Offset="1" /></LinearGradientBrush>
    <Thickness x:Key="NwtControlBevelThickness">0,1,0,1</Thickness>

    <!-- Inputs and displays -->
    <LinearGradientBrush x:Key="NwtInputBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF000000" Offset="0" /><GradientStop Color="#FF000000" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtInputForegroundBrush" Color="#FFFFD400" />
    <SolidColorBrush x:Key="NwtInputBorderBrush" Color="#FFFFFFFF" />
    <LinearGradientBrush x:Key="NwtInputBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#73000000" Offset="0" /><GradientStop Color="#73000000" Offset="0.5" /><GradientStop Color="#0FFFFFFF" Offset="0.5" /><GradientStop Color="#0FFFFFFF" Offset="1" /></LinearGradientBrush>
    <Thickness x:Key="NwtInputBevelThickness">0,1,0,1</Thickness>

    <!-- Accent -->
    <SolidColorBrush x:Key="NwtAccentBrush" Color="#FFFFD400" />
    <SolidColorBrush x:Key="NwtAccentHoverBrush" Color="#FFFFDA26" />
    <SolidColorBrush x:Key="NwtAccentPressedBrush" Color="#FFF2C900" />
    <SolidColorBrush x:Key="NwtAccentForegroundBrush" Color="#FF000000" />

    <!-- Selection, hover and focus -->
    <SolidColorBrush x:Key="NwtSelectionBrush" Color="#FF3D3300" />
    <SolidColorBrush x:Key="NwtSelectionForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtSelectionInactiveBrush" Color="#FF251F00" />
    <SolidColorBrush x:Key="NwtSelectionInactiveForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtHoverBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="NwtHoverForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtFocusBrush" Color="#99FFD400" />
    <SolidColorBrush x:Key="NwtGlyphBrush" Color="#FFFFFFFF" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="NwtTrackBrush" Color="#FF262626" />
    <LinearGradientBrush x:Key="NwtThumbBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFE6E6E6" Offset="0" /><GradientStop Color="#FF9A9A9A" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtThumbHoverBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFE9E9E9" Offset="0" /><GradientStop Color="#FFA6A6A6" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtThumbPressedBrush" Color="#FFFFD400" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="NwtTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="NwtTabIndicatorBrush" Color="#FFFFD400" />

    <!-- Glass: opaque, so high contrast never shows a blurred backdrop -->
    <SolidColorBrush x:Key="NwtGlassTintBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtWindowBackdropTintBrush" Color="#FF000000" />

    <!-- Shadows and depth -->
    <SolidColorBrush x:Key="NwtSliderThumbBrush" Color="#FF000000" />
    <DropShadowEffect x:Key="NwtPopupShadowEffect" BlurRadius="10" Opacity="1" ShadowDepth="2" Color="{StaticResource NwtShadowColor}" />
    <DropShadowEffect x:Key="NwtPanelShadowEffect" Opacity="0" />
    <DropShadowEffect x:Key="NwtAccentShadowEffect" Opacity="0" />
    <DropShadowEffect x:Key="NwtInputFocusShadowEffect" Opacity="0" />
    <DropShadowEffect x:Key="NwtThumbShadowEffect" Opacity="0" />

    <!-- Tooltips -->
    <SolidColorBrush x:Key="NwtToolTipBackgroundBrush" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="NwtToolTipForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtToolTipBorderBrush" Color="#FFFFFFFF" />

    <!-- Window chrome -->
    <SolidColorBrush x:Key="NwtTitleBarBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtTitleBarForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveBackgroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveForegroundBrush" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverForegroundBrush" Color="#FFFFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="NwtErrorBrush" Color="#FFFF4A4A" />

</ResourceDictionary>
