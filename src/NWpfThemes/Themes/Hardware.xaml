<!--
  Hardware theme

  Brushed metal panels, bevelled metal keys and recessed amber displays,
  in the spirit of bench instruments and studio gear.
  Every theme defines the same keys (see ThemeKeys.cs). To make your own theme, copy this
  file into your app, change the values, and apply it with ThemeManager.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Identity -->
    <sys:String x:Key="NwtThemeName">Hardware</sys:String>

    <!-- Typography -->
    <FontFamily x:Key="NwtFontFamily">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="NwtInputFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="NwtFontSize">13</sys:Double>
    <sys:Double x:Key="NwtFontSizeSmall">11.5</sys:Double>
    <sys:Double x:Key="NwtFontSizeLarge">16</sys:Double>

    <!-- Shape and spacing -->
    <CornerRadius x:Key="NwtControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="NwtOverlayCornerRadius">3</CornerRadius>
    <Thickness x:Key="NwtControlBorderThickness">1</Thickness>
    <Thickness x:Key="NwtControlPadding">12,5</Thickness>
    <sys:Double x:Key="NwtControlMinHeight">30</sys:Double>
    <sys:Double x:Key="NwtFocusStrokeThickness">2</sys:Double>

    <!-- Colours -->
    <Color x:Key="NwtBackgroundColor">#FF26282B</Color>
    <Color x:Key="NwtSurfaceColor">#FF34373B</Color>
    <Color x:Key="NwtForegroundColor">#FFE8EAEC</Color>
    <Color x:Key="NwtAccentColor">#FFFFA51F</Color>
    <Color x:Key="NwtBorderColor">#FF101113</Color>
    <Color x:Key="NwtShadowColor">#B0000000</Color>

    <!-- Window and text -->
    <LinearGradientBrush x:Key="NwtBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF2E3034" Offset="0" /><GradientStop Color="#FF1F2124" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtSurfaceBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF3C3F44" Offset="0" /><GradientStop Color="#FF303337" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtSurfaceAltBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF474A50" Offset="0" /><GradientStop Color="#FF393C41" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtForegroundBrush" Color="#FFE8EAEC" />
    <SolidColorBrush x:Key="NwtForegroundSecondaryBrush" Color="#FFBEC2C7" />
    <SolidColorBrush x:Key="NwtForegroundDisabledBrush" Color="#FF7A7E85" />
    <SolidColorBrush x:Key="NwtBorderBrush" Color="#FF101113" />
    <SolidColorBrush x:Key="NwtBorderHoverBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtSeparatorBrush" Color="#FF17181A" />

    <!-- Control faces -->
    <LinearGradientBrush x:Key="NwtControlBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFF2F3F4" Offset="0" /><GradientStop Color="#FFD3D6DA" Offset="0.45" /><GradientStop Color="#FFC8CCD0" Offset="0.55" /><GradientStop Color="#FFB3B8BE" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlHoverBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFFFF" Offset="0" /><GradientStop Color="#FFE2E5E8" Offset="0.45" /><GradientStop Color="#FFD7DADE" Offset="0.55" /><GradientStop Color="#FFC4C8CD" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlPressedBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFA4A9AF" Offset="0" /><GradientStop Color="#FFC9CDD1" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlDisabledBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF5A5D62" Offset="0" /><GradientStop Color="#FF4C4F54" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtControlForegroundBrush" Color="#FF16181B" />
    <SolidColorBrush x:Key="NwtControlHoverForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtControlBorderBrush" Color="#FF101113" />
    <LinearGradientBrush x:Key="NwtControlBevelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E6FFFFFF" Offset="0" /><GradientStop Color="#33FFFFFF" Offset="0.5" /><GradientStop Color="#66000000" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlPressedBevelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#CC000000" Offset="0" /><GradientStop Color="#33000000" Offset="0.5" /><GradientStop Color="#40FFFFFF" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlCheckedBevelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#CC000000" Offset="0" /><GradientStop Color="#33000000" Offset="0.5" /><GradientStop Color="#40FFFFFF" Offset="1" /></LinearGradientBrush>
    <Thickness x:Key="NwtControlBevelThickness">1</Thickness>

    <!-- Inputs and displays -->
    <LinearGradientBrush x:Key="NwtInputBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF0B0904" Offset="0" /><GradientStop Color="#FF17120A" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtInputForegroundBrush" Color="#FFFFB547" />
    <SolidColorBrush x:Key="NwtInputBorderBrush" Color="#FF8D9198" />
    <LinearGradientBrush x:Key="NwtInputBevelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#CC000000" Offset="0" /><GradientStop Color="#33000000" Offset="0.5" /><GradientStop Color="#40FFFFFF" Offset="1" /></LinearGradientBrush>
    <Thickness x:Key="NwtInputBevelThickness">1</Thickness>

    <!-- Accent -->
    <SolidColorBrush x:Key="NwtAccentBrush" Color="#FFFFA51F" />
    <SolidColorBrush x:Key="NwtAccentHoverBrush" Color="#FFFFB847" />
    <SolidColorBrush x:Key="NwtAccentPressedBrush" Color="#FFE08A0B" />
    <SolidColorBrush x:Key="NwtAccentForegroundBrush" Color="#FF1A1205" />

    <!-- Selection, hover and focus -->
    <SolidColorBrush x:Key="NwtSelectionBrush" Color="#FFFFA51F" />
    <SolidColorBrush x:Key="NwtSelectionForegroundBrush" Color="#FF1A1205" />
    <SolidColorBrush x:Key="NwtSelectionInactiveBrush" Color="#FF5C5040" />
    <SolidColorBrush x:Key="NwtSelectionInactiveForegroundBrush" Color="#FFF4E6D2" />
    <SolidColorBrush x:Key="NwtHoverBrush" Color="#FF494C52" />
    <SolidColorBrush x:Key="NwtHoverForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtFocusBrush" Color="#FFFFD27A" />
    <SolidColorBrush x:Key="NwtGlyphBrush" Color="#FFDADDE0" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="NwtTrackBrush" Color="#FF121315" />
    <LinearGradientBrush x:Key="NwtThumbBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFB9BDC2" Offset="0" /><GradientStop Color="#FF8E9399" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtThumbHoverBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFD5D8DC" Offset="0" /><GradientStop Color="#FFA7ABB1" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtThumbPressedBrush" Color="#FFE6E8EA" />

    <!-- Tooltips -->
    <SolidColorBrush x:Key="NwtToolTipBackgroundBrush" Color="#FF17120A" />
    <SolidColorBrush x:Key="NwtToolTipForegroundBrush" Color="#FFFFB547" />
    <SolidColorBrush x:Key="NwtToolTipBorderBrush" Color="#FF6B4A12" />

    <!-- Window chrome -->
    <LinearGradientBrush x:Key="NwtTitleBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF4A4D53" Offset="0" /><GradientStop Color="#FF33363A" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtTitleBarForegroundBrush" Color="#FFF2F3F4" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveBackgroundBrush" Color="#FF2E3034" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveForegroundBrush" Color="#FF9DA1A8" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverBrush" Color="#FF5A5E65" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverBrush" Color="#FFC8361F" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverForegroundBrush" Color="#FFFFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="NwtErrorBrush" Color="#FFFF8A70" />

</ResourceDictionary>
