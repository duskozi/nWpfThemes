<!--
  Alloy Night theme

  Alloy on dark anodised metal: the same light and depth, dark displays, orange accents.
  Matches the AlloyNight skin of nDAWControls.
  Every theme defines the same keys (see ThemeKeys.cs). To make your own theme, copy this
  file into your app, change the values, and apply it with ThemeManager.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Identity -->
    <sys:String x:Key="NwtThemeName">Alloy Night</sys:String>

    <!-- Typography -->
    <FontFamily x:Key="NwtFontFamily">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="NwtInputFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="NwtHeaderFontFamily">Bahnschrift, Segoe UI</FontFamily>
    <FontWeight x:Key="NwtHeaderFontWeight">SemiBold</FontWeight>
    <sys:Double x:Key="NwtFontSize">13</sys:Double>
    <sys:Double x:Key="NwtFontSizeSmall">11.5</sys:Double>
    <sys:Double x:Key="NwtFontSizeLarge">16</sys:Double>

    <!-- Shape and spacing -->
    <CornerRadius x:Key="NwtControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="NwtOverlayCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="NwtPanelCornerRadius">4</CornerRadius>
    <Thickness x:Key="NwtControlBorderThickness">1</Thickness>
    <Thickness x:Key="NwtControlPadding">10,4</Thickness>
    <sys:Double x:Key="NwtControlMinHeight">28</sys:Double>
    <sys:Double x:Key="NwtProgressBarThickness">10</sys:Double>
    <sys:Double x:Key="NwtFocusStrokeThickness">2</sys:Double>
    <sys:Double x:Key="NwtFocusCornerRadius">3</sys:Double>

    <!-- Colours -->
    <Color x:Key="NwtBackgroundColor">#FF1E2024</Color>
    <Color x:Key="NwtSurfaceColor">#FF464A51</Color>
    <Color x:Key="NwtForegroundColor">#FFE3E7EC</Color>
    <Color x:Key="NwtAccentColor">#FFFF9A1F</Color>
    <Color x:Key="NwtBorderColor">#FF0E0F11</Color>
    <Color x:Key="NwtShadowColor">#99000000</Color>

    <!-- Window and text -->
    <LinearGradientBrush x:Key="NwtBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF1E2024" Offset="0" /><GradientStop Color="#FF141518" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtSurfaceBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF464A51" Offset="0" /><GradientStop Color="#FF26282C" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtSurfaceAltBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF52565D" Offset="0" /><GradientStop Color="#FF33363B" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtForegroundBrush" Color="#FFE3E7EC" />
    <SolidColorBrush x:Key="NwtForegroundSecondaryBrush" Color="#FF9CA4AE" />
    <SolidColorBrush x:Key="NwtForegroundDisabledBrush" Color="#FF7B7F84" />
    <SolidColorBrush x:Key="NwtBorderBrush" Color="#FF0E0F11" />
    <SolidColorBrush x:Key="NwtBorderHoverBrush" Color="#FF0B0C0E" />
    <SolidColorBrush x:Key="NwtSeparatorBrush" Color="#FF0E0F11" />

    <!-- Control faces -->
    <LinearGradientBrush x:Key="NwtControlBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF50545B" Offset="0" /><GradientStop Color="#FF35383E" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlHoverBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF5A5F66" Offset="0" /><GradientStop Color="#FF3E4248" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlPressedBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF2A2C31" Offset="0" /><GradientStop Color="#FF34373C" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlDisabledBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF50545B" Offset="0" /><GradientStop Color="#FF35383E" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtControlForegroundBrush" Color="#FFE3E7EC" />
    <SolidColorBrush x:Key="NwtControlHoverForegroundBrush" Color="#FFE3E7EC" />
    <SolidColorBrush x:Key="NwtControlBorderBrush" Color="#FF0B0C0E" />
    <LinearGradientBrush x:Key="NwtControlBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#24FFFFFF" Offset="0" /><GradientStop Color="#24FFFFFF" Offset="0.5" /><GradientStop Color="#38000000" Offset="0.5" /><GradientStop Color="#38000000" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlPressedBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#24FFFFFF" Offset="0" /><GradientStop Color="#24FFFFFF" Offset="0.5" /><GradientStop Color="#38000000" Offset="0.5" /><GradientStop Color="#38000000" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlCheckedBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#73FFFFFF" Offset="0" /><GradientStop Color="#73FFFFFF" Offset="0.5" /><GradientStop Color="#26000000" Offset="0.5" /><GradientStop Color="#26000000" Offset="1" /></LinearGradientBrush>
    <Thickness x:Key="NwtControlBevelThickness">0,1,0,1</Thickness>

    <!-- Inputs and displays -->
    <LinearGradientBrush x:Key="NwtInputBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF0E1013" Offset="0" /><GradientStop Color="#FF1A1D21" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtInputForegroundBrush" Color="#FF9ED8FF" />
    <SolidColorBrush x:Key="NwtInputBorderBrush" Color="#FF0B0C0E" />
    <LinearGradientBrush x:Key="NwtInputBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#73000000" Offset="0" /><GradientStop Color="#73000000" Offset="0.5" /><GradientStop Color="#0FFFFFFF" Offset="0.5" /><GradientStop Color="#0FFFFFFF" Offset="1" /></LinearGradientBrush>
    <Thickness x:Key="NwtInputBevelThickness">0,1,0,1</Thickness>

    <!-- Accent -->
    <SolidColorBrush x:Key="NwtAccentBrush" Color="#FFFF9A1F" />
    <SolidColorBrush x:Key="NwtAccentHoverBrush" Color="#FFFFA941" />
    <SolidColorBrush x:Key="NwtAccentPressedBrush" Color="#FFF2921D" />
    <SolidColorBrush x:Key="NwtAccentForegroundBrush" Color="#FF2A1600" />

    <!-- Selection, hover and focus -->
    <SolidColorBrush x:Key="NwtSelectionBrush" Color="#FF3B3F46" />
    <SolidColorBrush x:Key="NwtSelectionForegroundBrush" Color="#FFE3E7EC" />
    <SolidColorBrush x:Key="NwtSelectionInactiveBrush" Color="#FF393D43" />
    <SolidColorBrush x:Key="NwtSelectionInactiveForegroundBrush" Color="#FFE3E7EC" />
    <SolidColorBrush x:Key="NwtHoverBrush" Color="#FF5A5F66" />
    <SolidColorBrush x:Key="NwtHoverForegroundBrush" Color="#FFE3E7EC" />
    <SolidColorBrush x:Key="NwtFocusBrush" Color="#FFFF9A1F" />
    <SolidColorBrush x:Key="NwtGlyphBrush" Color="#FFE3E7EC" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="NwtTrackBrush" Color="#FF0B0C0E" />
    <LinearGradientBrush x:Key="NwtThumbBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFAFBFC" Offset="0" /><GradientStop Color="#FF9AA1A9" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtThumbHoverBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFBFBFC" Offset="0" /><GradientStop Color="#FFA6ACB3" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtThumbPressedBrush" Color="#FFFF9A1F" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="NwtTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="NwtTabIndicatorBrush" Color="#FFFF9A1F" />

    <!-- Glass: the surface colour at 88 %, used only when an app sets a blurred backdrop -->
    <SolidColorBrush x:Key="NwtGlassTintBrush" Color="#E0464A51" />
    <SolidColorBrush x:Key="NwtWindowBackdropTintBrush" Color="#CC1E2024" />

    <!-- Tooltips -->
    <SolidColorBrush x:Key="NwtToolTipBackgroundBrush" Color="#FF52565D" />
    <SolidColorBrush x:Key="NwtToolTipForegroundBrush" Color="#FFE3E7EC" />
    <SolidColorBrush x:Key="NwtToolTipBorderBrush" Color="#FF0E0F11" />

    <!-- Window chrome -->
    <LinearGradientBrush x:Key="NwtTitleBarBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FF464A51" Offset="0" /><GradientStop Color="#FF26282C" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtTitleBarForegroundBrush" Color="#FFE3E7EC" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveBackgroundBrush" Color="#FF1E2024" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveForegroundBrush" Color="#FF9CA4AE" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverBrush" Color="#FF5A5F66" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverForegroundBrush" Color="#FFE3E7EC" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverForegroundBrush" Color="#FFFFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="NwtErrorBrush" Color="#FFFFBCB8" />

</ResourceDictionary>
