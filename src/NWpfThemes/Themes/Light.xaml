<!--
  Light theme

  A neutral light theme for everyday apps.
  Every theme defines the same keys (see ThemeKeys.cs). To make your own theme, copy this
  file into your app, change the values, and apply it with ThemeManager.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Identity -->
    <sys:String x:Key="NwtThemeName">Light</sys:String>

    <!-- Typography -->
    <FontFamily x:Key="NwtFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="NwtInputFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="NwtFontSize">13</sys:Double>
    <sys:Double x:Key="NwtFontSizeSmall">11.5</sys:Double>
    <sys:Double x:Key="NwtFontSizeLarge">16</sys:Double>

    <!-- Shape and spacing -->
    <CornerRadius x:Key="NwtControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="NwtOverlayCornerRadius">6</CornerRadius>
    <Thickness x:Key="NwtControlBorderThickness">1</Thickness>
    <Thickness x:Key="NwtControlPadding">10,5</Thickness>
    <sys:Double x:Key="NwtControlMinHeight">30</sys:Double>
    <sys:Double x:Key="NwtFocusStrokeThickness">2</sys:Double>

    <!-- Colours -->
    <Color x:Key="NwtBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="NwtSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="NwtForegroundColor">#FF1B1B1F</Color>
    <Color x:Key="NwtAccentColor">#FF0F5FC2</Color>
    <Color x:Key="NwtBorderColor">#FFC9CBD0</Color>
    <Color x:Key="NwtShadowColor">#40000000</Color>

    <!-- Window and text -->
    <SolidColorBrush x:Key="NwtBackgroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="NwtSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtSurfaceAltBrush" Color="#FFEDEEF0" />
    <SolidColorBrush x:Key="NwtForegroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="NwtForegroundSecondaryBrush" Color="#FF55585F" />
    <SolidColorBrush x:Key="NwtForegroundDisabledBrush" Color="#FF9EA1A6" />
    <SolidColorBrush x:Key="NwtBorderBrush" Color="#FFC9CBD0" />
    <SolidColorBrush x:Key="NwtBorderHoverBrush" Color="#FF8A8D93" />
    <SolidColorBrush x:Key="NwtSeparatorBrush" Color="#FFDADCE0" />

    <!-- Control faces -->
    <SolidColorBrush x:Key="NwtControlBackgroundBrush" Color="#FFFDFDFD" />
    <SolidColorBrush x:Key="NwtControlHoverBrush" Color="#FFEEF0F3" />
    <SolidColorBrush x:Key="NwtControlPressedBrush" Color="#FFE1E4E8" />
    <SolidColorBrush x:Key="NwtControlDisabledBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="NwtControlForegroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="NwtControlHoverForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtControlBevelBrush" Color="Transparent" />

    <!-- Inputs and displays -->
    <SolidColorBrush x:Key="NwtInputBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtInputForegroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="NwtInputBorderBrush" Color="#FF85888E" />
    <SolidColorBrush x:Key="NwtInputBevelBrush" Color="Transparent" />

    <!-- Accent -->
    <SolidColorBrush x:Key="NwtAccentBrush" Color="#FF0F5FC2" />
    <SolidColorBrush x:Key="NwtAccentHoverBrush" Color="#FF0D52A8" />
    <SolidColorBrush x:Key="NwtAccentPressedBrush" Color="#FF0B4690" />
    <SolidColorBrush x:Key="NwtAccentForegroundBrush" Color="#FFFFFFFF" />

    <!-- Selection, hover and focus -->
    <SolidColorBrush x:Key="NwtSelectionBrush" Color="#FF0F5FC2" />
    <SolidColorBrush x:Key="NwtSelectionForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtSelectionInactiveBrush" Color="#FFDDE1E6" />
    <SolidColorBrush x:Key="NwtSelectionInactiveForegroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="NwtHoverBrush" Color="#FFEAEDF1" />
    <SolidColorBrush x:Key="NwtHoverForegroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="NwtFocusBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtGlyphBrush" Color="#FF3A3D43" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="NwtTrackBrush" Color="#FFD5D8DD" />
    <SolidColorBrush x:Key="NwtThumbBrush" Color="#FF8A8D93" />
    <SolidColorBrush x:Key="NwtThumbHoverBrush" Color="#FF6F7279" />
    <SolidColorBrush x:Key="NwtThumbPressedBrush" Color="#FF55585E" />

    <!-- Tooltips -->
    <SolidColorBrush x:Key="NwtToolTipBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtToolTipForegroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="NwtToolTipBorderBrush" Color="#FFC9CBD0" />

    <!-- Window chrome -->
    <SolidColorBrush x:Key="NwtTitleBarBackgroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="NwtTitleBarForegroundBrush" Color="#FF1B1B1F" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveBackgroundBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveForegroundBrush" Color="#FF686B72" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverBrush" Color="#FFE1E4E8" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverForegroundBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverForegroundBrush" Color="#FFFFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="NwtErrorBrush" Color="#FFC42B1C" />

</ResourceDictionary>
