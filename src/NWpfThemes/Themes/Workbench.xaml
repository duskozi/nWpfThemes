<!--
  Workbench theme

  A compact, flat dark theme for tool and debugging apps: neutral charcoal panels, soft grey text,
  a bright blue accent, small 12 px type and dense 22 px controls with no gradients or bevels.
  Every theme defines the same keys (see ThemeKeys.cs).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Identity -->
    <sys:String x:Key="NwtThemeName">Workbench</sys:String>

    <!-- Typography -->
    <FontFamily x:Key="NwtFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="NwtInputFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="NwtHeaderFontFamily">Segoe UI</FontFamily>
    <FontWeight x:Key="NwtHeaderFontWeight">Normal</FontWeight>
    <sys:Double x:Key="NwtFontSize">12</sys:Double>
    <sys:Double x:Key="NwtFontSizeSmall">10.5</sys:Double>
    <sys:Double x:Key="NwtFontSizeLarge">14</sys:Double>

    <!-- Shape and spacing -->
    <CornerRadius x:Key="NwtControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="NwtOverlayCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="NwtPanelCornerRadius">0</CornerRadius>
    <Thickness x:Key="NwtControlBorderThickness">1</Thickness>
    <Thickness x:Key="NwtControlPadding">10,2</Thickness>
    <sys:Double x:Key="NwtControlMinHeight">22</sys:Double>
    <sys:Double x:Key="NwtProgressBarThickness">6</sys:Double>
    <sys:Double x:Key="NwtFocusStrokeThickness">1.5</sys:Double>
    <sys:Double x:Key="NwtFocusCornerRadius">3</sys:Double>

    <!-- Colours -->
    <Color x:Key="NwtBackgroundColor">#FF1E1F22</Color>
    <Color x:Key="NwtSurfaceColor">#FF2B2D30</Color>
    <Color x:Key="NwtForegroundColor">#FFBCBEC4</Color>
    <Color x:Key="NwtAccentColor">#FF4A9FFF</Color>
    <Color x:Key="NwtBorderColor">#FF3C3F41</Color>
    <Color x:Key="NwtShadowColor">#99000000</Color>

    <!-- Window and text -->
    <SolidColorBrush x:Key="NwtBackgroundBrush" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="NwtSurfaceBrush" Color="#FF2B2D30" />
    <SolidColorBrush x:Key="NwtSurfaceAltBrush" Color="#FF252628" />
    <SolidColorBrush x:Key="NwtForegroundBrush" Color="#FFBCBEC4" />
    <SolidColorBrush x:Key="NwtForegroundSecondaryBrush" Color="#FF9A9CA4" />
    <SolidColorBrush x:Key="NwtForegroundDisabledBrush" Color="#FF5A5C64" />
    <SolidColorBrush x:Key="NwtBorderBrush" Color="#FF3C3F41" />
    <SolidColorBrush x:Key="NwtBorderHoverBrush" Color="#FF5A5D60" />
    <SolidColorBrush x:Key="NwtSeparatorBrush" Color="#FF3C3F41" />

    <!-- Control faces: flat fills, one-pixel borders -->
    <SolidColorBrush x:Key="NwtControlBackgroundBrush" Color="#FF3C3F41" />
    <SolidColorBrush x:Key="NwtControlHoverBrush" Color="#FF4A4D50" />
    <SolidColorBrush x:Key="NwtControlPressedBrush" Color="#FF333538" />
    <SolidColorBrush x:Key="NwtControlDisabledBrush" Color="#FF2B2D30" />
    <SolidColorBrush x:Key="NwtControlForegroundBrush" Color="#FFBCBEC4" />
    <SolidColorBrush x:Key="NwtControlHoverForegroundBrush" Color="#FFDFE1E5" />
    <SolidColorBrush x:Key="NwtControlBorderBrush" Color="#FF5A5D60" />
    <SolidColorBrush x:Key="NwtControlBevelBrush" Color="Transparent" />
    <SolidColorBrush x:Key="NwtControlPressedBevelBrush" Color="Transparent" />
    <SolidColorBrush x:Key="NwtControlCheckedBevelBrush" Color="Transparent" />
    <Thickness x:Key="NwtControlBevelThickness">1</Thickness>

    <!-- Inputs and displays -->
    <SolidColorBrush x:Key="NwtInputBackgroundBrush" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="NwtInputForegroundBrush" Color="#FFBCBEC4" />
    <SolidColorBrush x:Key="NwtInputBorderBrush" Color="#FF6F737A" />
    <SolidColorBrush x:Key="NwtInputBevelBrush" Color="Transparent" />
    <Thickness x:Key="NwtInputBevelThickness">1</Thickness>

    <!-- Accent: a light blue, so text on accent fills is dark -->
    <SolidColorBrush x:Key="NwtAccentBrush" Color="#FF4A9FFF" />
    <SolidColorBrush x:Key="NwtAccentHoverBrush" Color="#FF6AB0FF" />
    <SolidColorBrush x:Key="NwtAccentPressedBrush" Color="#FF3A8AE6" />
    <SolidColorBrush x:Key="NwtAccentForegroundBrush" Color="#FF1E1F22" />

    <!-- Selection, hover and focus -->
    <SolidColorBrush x:Key="NwtSelectionBrush" Color="#FF1A2A4A" />
    <SolidColorBrush x:Key="NwtSelectionForegroundBrush" Color="#FFDFE1E5" />
    <SolidColorBrush x:Key="NwtSelectionInactiveBrush" Color="#FF2E3442" />
    <SolidColorBrush x:Key="NwtSelectionInactiveForegroundBrush" Color="#FFBCBEC4" />
    <SolidColorBrush x:Key="NwtHoverBrush" Color="#FF33353A" />
    <SolidColorBrush x:Key="NwtHoverForegroundBrush" Color="#FFBCBEC4" />
    <SolidColorBrush x:Key="NwtFocusBrush" Color="#FF4A9FFF" />
    <SolidColorBrush x:Key="NwtGlyphBrush" Color="#FFBCBEC4" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="NwtTrackBrush" Color="#FF3C3F41" />
    <SolidColorBrush x:Key="NwtThumbBrush" Color="#FF5A5D60" />
    <SolidColorBrush x:Key="NwtThumbHoverBrush" Color="#FF6E7175" />
    <SolidColorBrush x:Key="NwtThumbPressedBrush" Color="#FF85888C" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="NwtTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="NwtTabIndicatorBrush" Color="#FF4A9FFF" />

    <!-- Glass: the surface colour at 88 % (more opaque than Dark so the softer text stays readable), used only when an app sets a blurred backdrop -->
    <SolidColorBrush x:Key="NwtGlassTintBrush" Color="#E02B2D30" />
    <SolidColorBrush x:Key="NwtWindowBackdropTintBrush" Color="#CC1E1F22" />

    <!-- Shadows and depth -->
    <SolidColorBrush x:Key="NwtSliderThumbBrush" Color="#FF3C3F41" />
    <DropShadowEffect x:Key="NwtPopupShadowEffect" BlurRadius="10" Opacity="1" ShadowDepth="2" Color="{StaticResource NwtShadowColor}" />
    <DropShadowEffect x:Key="NwtPanelShadowEffect" Opacity="0" />
    <DropShadowEffect x:Key="NwtAccentShadowEffect" Opacity="0" />
    <DropShadowEffect x:Key="NwtInputFocusShadowEffect" Opacity="0" />
    <DropShadowEffect x:Key="NwtThumbShadowEffect" Opacity="0" />

    <!-- Tooltips -->
    <SolidColorBrush x:Key="NwtToolTipBackgroundBrush" Color="#FF1A1B1E" />
    <SolidColorBrush x:Key="NwtToolTipForegroundBrush" Color="#FFBCBEC4" />
    <SolidColorBrush x:Key="NwtToolTipBorderBrush" Color="#FF3C3F41" />

    <!-- Window chrome -->
    <SolidColorBrush x:Key="NwtTitleBarBackgroundBrush" Color="#FF1A1B1E" />
    <SolidColorBrush x:Key="NwtTitleBarForegroundBrush" Color="#FFBCBEC4" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveBackgroundBrush" Color="#FF1A1B1E" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveForegroundBrush" Color="#FF6E7078" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverBrush" Color="#FF3A3B3F" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverForegroundBrush" Color="#FFDFE1E5" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverBrush" Color="#FF7A2828" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverForegroundBrush" Color="#FFFFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="NwtErrorBrush" Color="#FFF87171" />

</ResourceDictionary>
