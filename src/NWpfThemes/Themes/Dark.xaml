<!--
  Dark theme

  A neutral dark theme for everyday apps.
  Every theme defines the same keys (see ThemeKeys.cs). To make your own theme, copy this
  file into your app, change the values, and apply it with ThemeManager.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Identity -->
    <sys:String x:Key="NwtThemeName">Dark</sys:String>

    <!-- Typography -->
    <FontFamily x:Key="NwtFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="NwtInputFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="NwtHeaderFontFamily">Segoe UI</FontFamily>
    <FontWeight x:Key="NwtHeaderFontWeight">SemiBold</FontWeight>
    <sys:Double x:Key="NwtFontSize">13</sys:Double>
    <sys:Double x:Key="NwtFontSizeSmall">11.5</sys:Double>
    <sys:Double x:Key="NwtFontSizeLarge">16</sys:Double>

    <!-- Shape and spacing -->
    <CornerRadius x:Key="NwtControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="NwtOverlayCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="NwtPanelCornerRadius">4</CornerRadius>
    <Thickness x:Key="NwtControlBorderThickness">1</Thickness>
    <Thickness x:Key="NwtControlPadding">10,5</Thickness>
    <sys:Double x:Key="NwtControlMinHeight">30</sys:Double>
    <sys:Double x:Key="NwtProgressBarThickness">10</sys:Double>
    <sys:Double x:Key="NwtFocusStrokeThickness">2</sys:Double>
    <sys:Double x:Key="NwtFocusCornerRadius">3</sys:Double>

    <!-- Colours -->
    <Color x:Key="NwtBackgroundColor">#FF1E1F22</Color>
    <Color x:Key="NwtSurfaceColor">#FF2B2D31</Color>
    <Color x:Key="NwtForegroundColor">#FFF2F3F5</Color>
    <Color x:Key="NwtAccentColor">#FF2D6BD6</Color>
    <Color x:Key="NwtBorderColor">#FF4E5058</Color>
    <Color x:Key="NwtShadowColor">#99000000</Color>

    <!-- Window and text -->
    <SolidColorBrush x:Key="NwtBackgroundBrush" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="NwtSurfaceBrush" Color="#FF2B2D31" />
    <SolidColorBrush x:Key="NwtSurfaceAltBrush" Color="#FF313338" />
    <SolidColorBrush x:Key="NwtForegroundBrush" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="NwtForegroundSecondaryBrush" Color="#FFB5BAC1" />
    <SolidColorBrush x:Key="NwtForegroundDisabledBrush" Color="#FF6D7178" />
    <SolidColorBrush x:Key="NwtBorderBrush" Color="#FF4E5058" />
    <SolidColorBrush x:Key="NwtBorderHoverBrush" Color="#FF80848E" />
    <SolidColorBrush x:Key="NwtSeparatorBrush" Color="#FF3F4248" />

    <!-- Control faces -->
    <SolidColorBrush x:Key="NwtControlBackgroundBrush" Color="#FF383A40" />
    <SolidColorBrush x:Key="NwtControlHoverBrush" Color="#FF43454B" />
    <SolidColorBrush x:Key="NwtControlPressedBrush" Color="#FF2E3035" />
    <SolidColorBrush x:Key="NwtControlDisabledBrush" Color="#FF2B2D31" />
    <SolidColorBrush x:Key="NwtControlForegroundBrush" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="NwtControlHoverForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtControlBorderBrush" Color="#FF4E5058" />
    <SolidColorBrush x:Key="NwtControlBevelBrush" Color="Transparent" />
    <SolidColorBrush x:Key="NwtControlPressedBevelBrush" Color="Transparent" />
    <SolidColorBrush x:Key="NwtControlCheckedBevelBrush" Color="Transparent" />
    <Thickness x:Key="NwtControlBevelThickness">1</Thickness>

    <!-- Inputs and displays -->
    <SolidColorBrush x:Key="NwtInputBackgroundBrush" Color="#FF1A1B1E" />
    <SolidColorBrush x:Key="NwtInputForegroundBrush" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="NwtInputBorderBrush" Color="#FF6D7178" />
    <SolidColorBrush x:Key="NwtInputBevelBrush" Color="Transparent" />
    <Thickness x:Key="NwtInputBevelThickness">1</Thickness>

    <!-- Accent -->
    <SolidColorBrush x:Key="NwtAccentBrush" Color="#FF2D6BD6" />
    <SolidColorBrush x:Key="NwtAccentHoverBrush" Color="#FF2560C4" />
    <SolidColorBrush x:Key="NwtAccentPressedBrush" Color="#FF1E4FA3" />
    <SolidColorBrush x:Key="NwtAccentForegroundBrush" Color="#FFFFFFFF" />

    <!-- Selection, hover and focus -->
    <SolidColorBrush x:Key="NwtSelectionBrush" Color="#FF2D6BD6" />
    <SolidColorBrush x:Key="NwtSelectionForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtSelectionInactiveBrush" Color="#FF404249" />
    <SolidColorBrush x:Key="NwtSelectionInactiveForegroundBrush" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="NwtHoverBrush" Color="#FF35373C" />
    <SolidColorBrush x:Key="NwtHoverForegroundBrush" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="NwtFocusBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtGlyphBrush" Color="#FFDBDEE1" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="NwtTrackBrush" Color="#FF404249" />
    <SolidColorBrush x:Key="NwtThumbBrush" Color="#FF6D7178" />
    <SolidColorBrush x:Key="NwtThumbHoverBrush" Color="#FF8A8E96" />
    <SolidColorBrush x:Key="NwtThumbPressedBrush" Color="#FFA3A7AE" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="NwtTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="NwtTabIndicatorBrush" Color="#FF2D6BD6" />

    <!-- Glass: the surface colour at 80 %, used only when an app sets a blurred backdrop -->
    <SolidColorBrush x:Key="NwtGlassTintBrush" Color="#CC2B2D31" />
    <SolidColorBrush x:Key="NwtWindowBackdropTintBrush" Color="#CC1E1F22" />

    <!-- Shadows and depth -->
    <SolidColorBrush x:Key="NwtSliderThumbBrush" Color="#FF383A40" />
    <DropShadowEffect x:Key="NwtPopupShadowEffect" BlurRadius="10" Opacity="1" ShadowDepth="2" Color="{StaticResource NwtShadowColor}" />
    <DropShadowEffect x:Key="NwtPanelShadowEffect" Opacity="0" />
    <DropShadowEffect x:Key="NwtAccentShadowEffect" Opacity="0" />
    <DropShadowEffect x:Key="NwtInputFocusShadowEffect" Opacity="0" />
    <DropShadowEffect x:Key="NwtThumbShadowEffect" Opacity="0" />

    <!-- Tooltips -->
    <SolidColorBrush x:Key="NwtToolTipBackgroundBrush" Color="#FF111214" />
    <SolidColorBrush x:Key="NwtToolTipForegroundBrush" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="NwtToolTipBorderBrush" Color="#FF4E5058" />

    <!-- Window chrome -->
    <SolidColorBrush x:Key="NwtTitleBarBackgroundBrush" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="NwtTitleBarForegroundBrush" Color="#FFF2F3F5" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveBackgroundBrush" Color="#FF1E1F22" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveForegroundBrush" Color="#FF9A9EA6" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverBrush" Color="#FF3A3C42" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverForegroundBrush" Color="#FFFFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="NwtErrorBrush" Color="#FFFF7A70" />

</ResourceDictionary>
