<!--
  Light Classic theme

  Light grey with a blue accent and a green-grey display.
  Matches the LightClassic skin of nDAWControls.
  Every theme defines the same keys (see ThemeKeys.cs). To make your own theme, copy this
  file into your app, change the values, and apply it with ThemeManager.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Identity -->
    <sys:String x:Key="NwtThemeName">Light Classic</sys:String>

    <!-- Typography -->
    <FontFamily x:Key="NwtFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="NwtInputFontFamily">Consolas</FontFamily>
    <FontFamily x:Key="NwtHeaderFontFamily">Segoe UI</FontFamily>
    <FontWeight x:Key="NwtHeaderFontWeight">SemiBold</FontWeight>
    <sys:Double x:Key="NwtFontSize">13</sys:Double>
    <sys:Double x:Key="NwtFontSizeSmall">11.5</sys:Double>
    <sys:Double x:Key="NwtFontSizeLarge">16</sys:Double>

    <!-- Shape and spacing -->
    <CornerRadius x:Key="NwtControlCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="NwtOverlayCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="NwtPanelCornerRadius">3</CornerRadius>
    <Thickness x:Key="NwtControlBorderThickness">1</Thickness>
    <Thickness x:Key="NwtControlPadding">10,4</Thickness>
    <sys:Double x:Key="NwtControlMinHeight">28</sys:Double>
    <sys:Double x:Key="NwtProgressBarThickness">10</sys:Double>
    <sys:Double x:Key="NwtFocusStrokeThickness">2</sys:Double>
    <sys:Double x:Key="NwtFocusCornerRadius">3</sys:Double>

    <!-- Colours -->
    <Color x:Key="NwtBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="NwtSurfaceColor">#FFECEEF1</Color>
    <Color x:Key="NwtForegroundColor">#FF1D2128</Color>
    <Color x:Key="NwtAccentColor">#FF1F6FD1</Color>
    <Color x:Key="NwtBorderColor">#FFB7BDC6</Color>
    <Color x:Key="NwtShadowColor">#40000000</Color>

    <!-- Window and text -->
    <SolidColorBrush x:Key="NwtBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtSurfaceBrush" Color="#FFECEEF1" />
    <SolidColorBrush x:Key="NwtSurfaceAltBrush" Color="#FFE1E4E8" />
    <SolidColorBrush x:Key="NwtForegroundBrush" Color="#FF1D2128" />
    <SolidColorBrush x:Key="NwtForegroundSecondaryBrush" Color="#FF525863" />
    <SolidColorBrush x:Key="NwtForegroundDisabledBrush" Color="#FF999CA1" />
    <SolidColorBrush x:Key="NwtBorderBrush" Color="#FFB7BDC6" />
    <SolidColorBrush x:Key="NwtBorderHoverBrush" Color="#FF9DA4AE" />
    <SolidColorBrush x:Key="NwtSeparatorBrush" Color="#FFB7BDC6" />

    <!-- Control faces -->
    <SolidColorBrush x:Key="NwtControlBackgroundBrush" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="NwtControlHoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtControlPressedBrush" Color="#FFD3D7DD" />
    <SolidColorBrush x:Key="NwtControlDisabledBrush" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="NwtControlForegroundBrush" Color="#FF1D2128" />
    <SolidColorBrush x:Key="NwtControlHoverForegroundBrush" Color="#FF1D2128" />
    <SolidColorBrush x:Key="NwtControlBorderBrush" Color="#FF9DA4AE" />
    <LinearGradientBrush x:Key="NwtControlBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#24FFFFFF" Offset="0" /><GradientStop Color="#24FFFFFF" Offset="0.5" /><GradientStop Color="#38000000" Offset="0.5" /><GradientStop Color="#38000000" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlPressedBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#24FFFFFF" Offset="0" /><GradientStop Color="#24FFFFFF" Offset="0.5" /><GradientStop Color="#38000000" Offset="0.5" /><GradientStop Color="#38000000" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtControlCheckedBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#73FFFFFF" Offset="0" /><GradientStop Color="#73FFFFFF" Offset="0.5" /><GradientStop Color="#26000000" Offset="0.5" /><GradientStop Color="#26000000" Offset="1" /></LinearGradientBrush>
    <Thickness x:Key="NwtControlBevelThickness">0,1,0,1</Thickness>

    <!-- Inputs and displays -->
    <LinearGradientBrush x:Key="NwtInputBackgroundBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFD9E2C9" Offset="0" /><GradientStop Color="#FFC9D4B6" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtInputForegroundBrush" Color="#FF1E2A17" />
    <SolidColorBrush x:Key="NwtInputBorderBrush" Color="#FF7E858F" />
    <LinearGradientBrush x:Key="NwtInputBevelBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#73000000" Offset="0" /><GradientStop Color="#73000000" Offset="0.5" /><GradientStop Color="#0FFFFFFF" Offset="0.5" /><GradientStop Color="#0FFFFFFF" Offset="1" /></LinearGradientBrush>
    <Thickness x:Key="NwtInputBevelThickness">0,1,0,1</Thickness>

    <!-- Accent -->
    <SolidColorBrush x:Key="NwtAccentBrush" Color="#FF1F6FD1" />
    <SolidColorBrush x:Key="NwtAccentHoverBrush" Color="#FF1C64BC" />
    <SolidColorBrush x:Key="NwtAccentPressedBrush" Color="#FF1959A7" />
    <SolidColorBrush x:Key="NwtAccentForegroundBrush" Color="#FFFFFFFF" />

    <!-- Selection, hover and focus -->
    <SolidColorBrush x:Key="NwtSelectionBrush" Color="#FFD7E6FA" />
    <SolidColorBrush x:Key="NwtSelectionForegroundBrush" Color="#FF1D2128" />
    <SolidColorBrush x:Key="NwtSelectionInactiveBrush" Color="#FFDFE9F6" />
    <SolidColorBrush x:Key="NwtSelectionInactiveForegroundBrush" Color="#FF1D2128" />
    <SolidColorBrush x:Key="NwtHoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtHoverForegroundBrush" Color="#FF1D2128" />
    <SolidColorBrush x:Key="NwtFocusBrush" Color="#FF1F6FD1" />
    <SolidColorBrush x:Key="NwtGlyphBrush" Color="#FF1D2128" />

    <!-- Tracks and thumbs -->
    <SolidColorBrush x:Key="NwtTrackBrush" Color="#FFB7BDC6" />
    <LinearGradientBrush x:Key="NwtThumbBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFFFF" Offset="0" /><GradientStop Color="#FFD3D7DD" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="NwtThumbHoverBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFFFF" Offset="0" /><GradientStop Color="#FFD8DCE1" Offset="1" /></LinearGradientBrush>
    <SolidColorBrush x:Key="NwtThumbPressedBrush" Color="#FF1F6FD1" />

    <!-- Tabs -->
    <SolidColorBrush x:Key="NwtTabSelectedBrush" Color="Transparent" />
    <SolidColorBrush x:Key="NwtTabIndicatorBrush" Color="#FF1F6FD1" />

    <!-- Glass: the surface colour at 80 %, used only when an app sets a blurred backdrop -->
    <SolidColorBrush x:Key="NwtGlassTintBrush" Color="#CCECEEF1" />

    <!-- Tooltips -->
    <SolidColorBrush x:Key="NwtToolTipBackgroundBrush" Color="#FFE1E4E8" />
    <SolidColorBrush x:Key="NwtToolTipForegroundBrush" Color="#FF1D2128" />
    <SolidColorBrush x:Key="NwtToolTipBorderBrush" Color="#FFB7BDC6" />

    <!-- Window chrome -->
    <SolidColorBrush x:Key="NwtTitleBarBackgroundBrush" Color="#FFECEEF1" />
    <SolidColorBrush x:Key="NwtTitleBarForegroundBrush" Color="#FF1D2128" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtTitleBarInactiveForegroundBrush" Color="#FF525863" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="NwtCaptionButtonHoverForegroundBrush" Color="#FF1D2128" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="NwtCloseButtonHoverForegroundBrush" Color="#FFFFFFFF" />

    <!-- Status -->
    <SolidColorBrush x:Key="NwtErrorBrush" Color="#FFC22237" />

</ResourceDictionary>
