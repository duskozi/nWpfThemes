<!-- Button, RepeatButton, ToggleButton, CheckBox and RadioButton. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:nwt="clr-namespace:NWpfThemes">

    <ControlTemplate x:Key="NwtButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource NwtControlCornerRadius}"
                SnapsToDevicePixels="True">
            <Grid>
                <!-- Shows a blurred backdrop under a translucent face; see Glass. -->
                <nwt:GlassBackdropLayer CornerRadius="{DynamicResource NwtControlCornerRadius}" Tint="{TemplateBinding Background}" />
                <Border x:Name="Bevel"
                        BorderBrush="{DynamicResource NwtControlBevelBrush}"
                        BorderThickness="{DynamicResource NwtControlBevelThickness}"
                        CornerRadius="{DynamicResource NwtControlCornerRadius}">
                    <ContentPresenter x:Name="Content"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Border>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bevel" Property="BorderBrush" Value="{DynamicResource NwtControlPressedBevelBrush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Bevel" Property="BorderBrush" Value="{DynamicResource NwtControlCheckedBevelBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="NwtButtonBaseStyle" TargetType="ButtonBase">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource NwtFocusVisualStyle}" />
        <Setter Property="Background" Value="{DynamicResource NwtControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NwtControlForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NwtControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource NwtControlBorderThickness}" />
        <Setter Property="FontFamily" Value="{DynamicResource NwtFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource NwtFontSize}" />
        <Setter Property="Padding" Value="{DynamicResource NwtControlPadding}" />
        <Setter Property="MinHeight" Value="{DynamicResource NwtControlMinHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource NwtButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NwtControlHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NwtControlHoverForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NwtBorderHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NwtControlPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NwtControlHoverForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A button filled with the accent colour, for the main action. Buttons with IsDefault="True" look the same. -->
    <Style x:Key="NwtAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource NwtButtonBaseStyle}">
        <Setter Property="Background" Value="{DynamicResource NwtAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NwtAccentForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NwtAccentPressedBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource NwtAccentHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NwtAccentForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NwtAccentPressedBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource NwtAccentPressedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NwtAccentForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource NwtControlDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NwtForegroundDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NwtControlBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource NwtButtonBaseStyle}">
        <Style.Triggers>
            <Trigger Property="IsDefault" Value="True">
                <Setter Property="Background" Value="{DynamicResource NwtAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NwtAccentForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NwtAccentPressedBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource NwtAccentHoverBrush}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsDefault" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource NwtAccentPressedBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource NwtControlDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NwtForegroundDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NwtControlBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="RepeatButton" BasedOn="{StaticResource NwtButtonBaseStyle}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource NwtControlDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NwtForegroundDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToggleButton" BasedOn="{StaticResource NwtButtonBaseStyle}">
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource NwtAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NwtAccentForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NwtAccentPressedBrush}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource NwtAccentHoverBrush}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource NwtControlDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource NwtForegroundDisabledBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource NwtControlBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource NwtFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource NwtForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource NwtInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NwtInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource NwtControlBorderThickness}" />
        <Setter Property="FontFamily" Value="{DynamicResource NwtFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource NwtFontSize}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <Border x:Name="Bevel"
                                        BorderBrush="{DynamicResource NwtInputBevelBrush}"
                                        BorderThickness="{DynamicResource NwtInputBevelThickness}"
                                        CornerRadius="2" />
                                <Path x:Name="Check"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M 0,4.5 L 3.5,8 L 10,1"
                                      Stroke="{DynamicResource NwtAccentForegroundBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2"
                                      Visibility="Collapsed" />
                                <Rectangle x:Name="Dash"
                                           Width="8"
                                           Height="2"
                                           Fill="{DynamicResource NwtAccentForegroundBrush}"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="Content"
                                          Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource NwtBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource NwtAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource NwtAccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource NwtAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource NwtAccentBrush}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource NwtAccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource NwtAccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource NwtForegroundDisabledBrush}" />
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource NwtControlDisabledBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource NwtForegroundDisabledBrush}" />
                            <Setter TargetName="Check" Property="Stroke" Value="{DynamicResource NwtForegroundDisabledBrush}" />
                            <Setter TargetName="Dash" Property="Fill" Value="{DynamicResource NwtForegroundDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource NwtFocusVisualStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource NwtForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource NwtInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NwtInputBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource NwtControlBorderThickness}" />
        <Setter Property="FontFamily" Value="{DynamicResource NwtFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource NwtFontSize}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Circle"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <Grid>
                                <Border BorderBrush="{DynamicResource NwtInputBevelBrush}"
                                        BorderThickness="{DynamicResource NwtInputBevelThickness}"
                                        CornerRadius="8" />
                                <Ellipse x:Name="Dot"
                                         Width="8"
                                         Height="8"
                                         Fill="{DynamicResource NwtAccentForegroundBrush}"
                                         Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="Content"
                                          Grid.Column="1"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource NwtBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource NwtAccentBrush}" />
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource NwtAccentBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource NwtAccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource NwtForegroundDisabledBrush}" />
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource NwtControlDisabledBrush}" />
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource NwtForegroundDisabledBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource NwtForegroundDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toolbar buttons are flat until the mouse is over them. -->
    <ControlTemplate x:Key="NwtFlatButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd"
                Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource NwtControlCornerRadius}"
                SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Focusable="False"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource NwtButtonBaseStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NwtForegroundBrush}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template" Value="{StaticResource NwtFlatButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource NwtForegroundDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource NwtForegroundBrush}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template" Value="{StaticResource NwtFlatButtonTemplate}" />
    </Style>

    <Style x:Key="{x:Static ToolBar.CheckBoxStyleKey}" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <Style x:Key="{x:Static ToolBar.RadioButtonStyleKey}" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <!--
      DataGridCheckBoxColumn gives its check boxes an explicit style, so they skip the implicit one.
      Set ElementStyle="{StaticResource NwtDataGridCheckBoxStyle}" and
      EditingElementStyle="{StaticResource NwtDataGridEditingCheckBoxStyle}" on the column to theme them.
    -->
    <Style x:Key="NwtDataGridEditingCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="NwtDataGridCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource NwtDataGridEditingCheckBoxStyle}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>

</ResourceDictionary>
