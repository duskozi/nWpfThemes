<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Lets the WPF projects compile on non-Windows machines. Running them still needs Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>Duško Žigić</Authors>
    <Copyright>Copyright (c) 2026 Duško Žigić</Copyright>
    <RepositoryUrl>https://github.com/duskozi/nWpfThemes</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version Condition="'$(Version)' == ''">0.1.0-dev</Version>
  </PropertyGroup>
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
