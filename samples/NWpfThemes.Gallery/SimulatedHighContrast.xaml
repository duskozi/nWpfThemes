<!--
  A dark high contrast palette for previewing the High Contrast theme on a machine where Windows
  high contrast is off. It overrides the Windows system colour keys that the theme reads.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="{x:Static SystemColors.WindowColorKey}">#FF000000</Color>
    <Color x:Key="{x:Static SystemColors.WindowTextColorKey}">#FFFFFFFF</Color>
    <Color x:Key="{x:Static SystemColors.GrayTextColorKey}">#FF3FF23F</Color>
    <Color x:Key="{x:Static SystemColors.HighlightColorKey}">#FF1AEBFF</Color>
    <Color x:Key="{x:Static SystemColors.HighlightTextColorKey}">#FF000000</Color>
    <Color x:Key="{x:Static SystemColors.ControlColorKey}">#FF000000</Color>
    <Color x:Key="{x:Static SystemColors.ControlTextColorKey}">#FFFFFFFF</Color>
    <Color x:Key="{x:Static SystemColors.InfoColorKey}">#FF000000</Color>
    <Color x:Key="{x:Static SystemColors.InfoTextColorKey}">#FFFFFF00</Color>
    <Color x:Key="{x:Static SystemColors.ActiveCaptionColorKey}">#FF000000</Color>
    <Color x:Key="{x:Static SystemColors.ActiveCaptionTextColorKey}">#FFFFFFFF</Color>
    <Color x:Key="{x:Static SystemColors.InactiveCaptionColorKey}">#FF000000</Color>
    <Color x:Key="{x:Static SystemColors.InactiveCaptionTextColorKey}">#FF3FF23F</Color>
</ResourceDictionary>
