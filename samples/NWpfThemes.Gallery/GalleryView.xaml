<UserControl x:Class="NWpfThemes.Gallery.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nwt="https://github.com/duskozi/nWpfThemes">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="Row" TargetType="WrapPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Margin="8,4">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O" />
                <Separator />
                <MenuItem Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Status bar" IsCheckable="True" IsChecked="True" />
                <MenuItem Header="_Zoom">
                    <MenuItem Header="Zoom _in" />
                    <MenuItem Header="Zoom _out" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help" />
        </Menu>

        <ToolBarTray DockPanel.Dock="Top" Margin="8,0,8,8" IsLocked="False">
            <ToolBar>
                <Button Content="New" ToolTip="Create a document" />
                <Button Content="Open" />
                <Button Content="Save" IsEnabled="False" />
                <Separator />
                <ToggleButton Content="Bold" IsChecked="True" />
                <ToggleButton Content="Italic" />
                <Separator />
                <CheckBox Content="Wrap" IsChecked="True" />
                <ComboBox Width="90" SelectedIndex="0">
                    <ComboBoxItem Content="100 %" />
                    <ComboBoxItem Content="150 %" />
                </ComboBox>
                <TextBox Width="120" Text="Search" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="Ready" />
            <Separator />
            <StatusBarItem Content="Ln 12, Col 4" />
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" Height="8" Value="40" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16,8,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 1 -->
            <StackPanel>
                <GroupBox Header="Buttons" Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel Style="{StaticResource Row}">
                            <Button Content="Button" Margin="0,0,8,8" />
                            <Button Content="Accent" Style="{DynamicResource NwtAccentButtonStyle}" Margin="0,0,8,8" />
                            <Button Content="Disabled" IsEnabled="False" Margin="0,0,8,8" />
                        </WrapPanel>
                        <WrapPanel>
                            <RepeatButton Content="Repeat" Margin="0,0,8,8" />
                            <ToggleButton Content="Toggle on" IsChecked="True" Margin="0,0,8,8" />
                            <ToggleButton Content="Toggle off" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Check boxes and radio buttons" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <CheckBox Content="Unchecked" />
                            <CheckBox Content="Checked" IsChecked="True" />
                            <CheckBox Content="Indeterminate" IsChecked="{x:Null}" IsThreeState="True" />
                            <CheckBox Content="Disabled" IsChecked="True" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <RadioButton Content="First" GroupName="Demo" IsChecked="True" />
                            <RadioButton Content="Second" GroupName="Demo" />
                            <RadioButton Content="Third" GroupName="Demo" />
                            <RadioButton Content="Disabled" GroupName="Other" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Text input" Style="{StaticResource Card}">
                    <StackPanel>
                        <Label Content="_Name" Target="{Binding ElementName=NameBox}" />
                        <TextBox x:Name="NameBox" Text="Ada Lovelace" Margin="0,0,0,8" />
                        <Label Content="_Password" Target="{Binding ElementName=PasswordBox}" />
                        <PasswordBox x:Name="PasswordBox" Margin="0,0,0,8" />
                        <TextBox Text="Read-only and disabled" IsEnabled="False" Margin="0,0,0,8" />
                        <TextBox Height="64"
                                 AcceptsReturn="True"
                                 Text="A multi-line text box&#x0a;with a second line&#x0a;and a third."
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Combo boxes" Style="{StaticResource Card}">
                    <StackPanel>
                        <ComboBox SelectedIndex="1" Margin="0,0,0,8">
                            <ComboBoxItem Content="Red" />
                            <ComboBoxItem Content="Green" />
                            <ComboBoxItem Content="Blue" />
                        </ComboBox>
                        <ComboBox IsEditable="True" Text="Editable" Margin="0,0,0,8">
                            <ComboBoxItem Content="One" />
                            <ComboBoxItem Content="Two" />
                        </ComboBox>
                        <ComboBox IsEnabled="False" SelectedIndex="0">
                            <ComboBoxItem Content="Disabled" />
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Tooltip and context menu" Style="{StaticResource Card}">
                    <StackPanel>
                        <!-- A tooltip cannot sit in a panel, so this preview draws one from the same theme keys. -->
                        <Border Margin="0,0,0,10"
                                Padding="8,4"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource NwtToolTipBackgroundBrush}"
                                BorderBrush="{DynamicResource NwtToolTipBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource NwtOverlayCornerRadius}">
                            <TextBlock FontSize="{DynamicResource NwtFontSizeSmall}"
                                       Foreground="{DynamicResource NwtToolTipForegroundBrush}"
                                       Text="What a tooltip looks like" />
                        </Border>
                        <Button Content="Right-click for a context menu" HorizontalAlignment="Left" ToolTip="A real tooltip">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Cut" InputGestureText="Ctrl+X" />
                                    <MenuItem Header="Copy" InputGestureText="Ctrl+C" />
                                    <MenuItem Header="Word wrap" IsCheckable="True" IsChecked="True" />
                                    <Separator />
                                    <MenuItem Header="More">
                                        <MenuItem Header="Inside" />
                                    </MenuItem>
                                    <MenuItem Header="Unavailable" IsEnabled="False" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!-- Column 2 -->
            <StackPanel Grid.Column="2">
                <GroupBox Header="Sliders and progress" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Slider Maximum="100" Value="60" Margin="0,0,0,8" />
                            <Slider Maximum="10" TickFrequency="1" TickPlacement="BottomRight" Value="3" Margin="0,0,0,8" />
                            <Slider Maximum="100" Value="30" IsEnabled="False" Margin="0,0,0,12" />
                            <ProgressBar Value="65" Margin="0,0,0,10" />
                            <ProgressBar IsIndeterminate="True" Margin="0,0,0,10" />
                            <ProgressBar Value="30" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal">
                            <Slider Height="140" Maximum="100" Orientation="Vertical" Value="70" />
                            <ProgressBar Height="140" Margin="12,0,0,0" Orientation="Vertical" Value="45" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="List box" Style="{StaticResource Card}">
                    <ListBox x:Name="Fruits" Height="150" SelectedIndex="2" />
                </GroupBox>

                <GroupBox Header="Tree view" Style="{StaticResource Card}">
                    <TreeView Height="170">
                        <TreeViewItem Header="Documents" IsExpanded="True">
                            <TreeViewItem Header="Reports" IsExpanded="True">
                                <TreeViewItem Header="2025.pdf" />
                                <TreeViewItem Header="2026.pdf" IsSelected="True" />
                            </TreeViewItem>
                            <TreeViewItem Header="Letters">
                                <TreeViewItem Header="Draft.txt" />
                            </TreeViewItem>
                        </TreeViewItem>
                        <TreeViewItem Header="Pictures">
                            <TreeViewItem Header="Holiday" />
                        </TreeViewItem>
                        <TreeViewItem Header="Music" />
                    </TreeView>
                </GroupBox>

                <Expander Header="Expander (open)" IsExpanded="True" Margin="0,0,0,8">
                    <TextBlock Text="Content that shows when the expander is open." TextWrapping="Wrap" />
                </Expander>
                <Expander Header="Expander (closed)" Margin="0,0,0,16">
                    <TextBlock Text="Hidden content." />
                </Expander>
            </StackPanel>

            <!-- Column 3 -->
            <StackPanel Grid.Column="4">
                <TabControl Height="150" Margin="0,0,0,16">
                    <TabItem Header="General">
                        <StackPanel>
                            <TextBlock Text="Tab content sits on a surface." Margin="0,0,0,8" />
                            <CheckBox Content="Start with Windows" IsChecked="True" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Advanced" />
                    <TabItem Header="Disabled" IsEnabled="False" />
                </TabControl>

                <GroupBox Header="List view" Style="{StaticResource Card}">
                    <ListView x:Name="Files" Height="140" SelectedIndex="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="130" DisplayMemberBinding="{Binding Name}" Header="Name" />
                                <GridViewColumn Width="70" DisplayMemberBinding="{Binding Size}" Header="Size" />
                                <GridViewColumn Width="90" DisplayMemberBinding="{Binding Kind}" Header="Type" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>

                <GroupBox Header="Data grid" Style="{StaticResource Card}">
                    <DataGrid x:Name="People"
                              Height="170"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="All"
                              SelectedIndex="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Name" SortDirection="Ascending" />
                            <DataGridTextColumn Width="60" Binding="{Binding Age}" Header="Age" />
                            <DataGridCheckBoxColumn Width="70"
                                                    Binding="{Binding Active}"
                                                    EditingElementStyle="{StaticResource NwtDataGridEditingCheckBoxStyle}"
                                                    ElementStyle="{StaticResource NwtDataGridCheckBoxStyle}"
                                                    Header="Active" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <GroupBox Header="Scoped theme" Style="{StaticResource Card}">
                    <Border nwt:ThemeManager.Theme="Hardware"
                            Padding="12"
                            Background="{DynamicResource NwtBackgroundBrush}"
                            CornerRadius="4"
                            TextElement.Foreground="{DynamicResource NwtForegroundBrush}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8" Text="This panel uses the Hardware theme." />
                            <WrapPanel>
                                <Button Content="Play" Margin="0,0,8,8" />
                                <ToggleButton Content="Rec" IsChecked="True" Margin="0,0,8,8" />
                                <TextBox Width="110" Text="00:42.17" Margin="0,0,8,8" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <!--
                  Frosted glass: the panels on the right blur whatever the "GlassArt" layer draws behind
                  them. Drag the "Deposits" card to see the blur follow it.
                -->
                <GroupBox Header="Frosted glass" Style="{StaticResource Card}">
                    <Grid Height="236" ClipToBounds="True">
                        <Canvas x:Name="GlassArt" Background="{DynamicResource NwtBackgroundBrush}">
                            <Ellipse Canvas.Left="-30" Canvas.Top="-40" Width="220" Height="220">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0" Color="#CC7B6CF6" />
                                        <GradientStop Offset="1" Color="#007B6CF6" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Canvas.Left="200" Canvas.Top="70" Width="200" Height="200">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0" Color="#B33BC9DB" />
                                        <GradientStop Offset="1" Color="#003BC9DB" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Canvas.Left="110" Canvas.Top="130" Width="150" Height="150">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Offset="0" Color="#B3F06595" />
                                        <GradientStop Offset="1" Color="#00F06595" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Polyline Points="0,190 40,170 80,182 120,140 160,150 200,100 240,118 280,70 320,86 360,40 400,52"
                                      Stroke="{DynamicResource NwtForegroundBrush}"
                                      StrokeThickness="3" />
                            <TextBlock Canvas.Left="210"
                                       Canvas.Top="8"
                                       FontFamily="{DynamicResource NwtHeaderFontFamily}"
                                       FontSize="40"
                                       Foreground="{DynamicResource NwtForegroundBrush}"
                                       Text="61.2%" />
                        </Canvas>

                        <Canvas x:Name="GlassLayer" nwt:Glass.Backdrop="{Binding ElementName=GlassArt}">
                            <GroupBox x:Name="GlassCard"
                                      Canvas.Left="14"
                                      Canvas.Top="20"
                                      Width="180"
                                      Cursor="SizeAll"
                                      Header="Deposits"
                                      ToolTip="Drag me">
                                <StackPanel>
                                    <TextBlock FontFamily="{DynamicResource NwtHeaderFontFamily}" FontSize="24" Text="$40.7B" />
                                    <ProgressBar Margin="0,8,0,0" Value="64" />
                                </StackPanel>
                            </GroupBox>
                            <Expander Canvas.Left="206"
                                      Canvas.Top="96"
                                      Width="176"
                                      Header="Glass expander"
                                      IsExpanded="True">
                                <TextBlock Text="The blur is drawn by the app, so it looks the same on Windows 10 and 11." TextWrapping="Wrap" />
                            </Expander>
                        </Canvas>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
